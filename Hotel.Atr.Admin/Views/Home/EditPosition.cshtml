@model Position

<h1>Edit/Add Position</h1>

<form asp-action="EditPosition" asp-controller="Home" method="post">
    <table>
        <tr>
            <td>ID</td>
            <td>
                <label asp-for="Id">@Model.Id</label>
            </td>
        </tr>
        <tr>
            <td>NAME</td>
            <td>
                <input type="text" asp-for="Name" />
            </td>
        </tr>
    </table>

    <hr />
    <button type="submit">Save</button>
</form>